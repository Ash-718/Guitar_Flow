# MongoDB connection string.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=guitarflow

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Path to a Firebase service account JSON (Project settings > Service accounts > Generate new private key).
# Leave blank only if AUTH_DEV_BYPASS=true.
FIREBASE_SERVICE_ACCOUNT_PATH=

# DEV ONLY: when true, protected routes accept a synthetic dev user instead of
# verifying a real Firebase ID token. Never set this to true in production.
AUTH_DEV_BYPASS=true
