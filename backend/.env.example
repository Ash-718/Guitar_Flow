# MongoDB connection string.
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=guitarflow

# CORS: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Path to a Firebase service account JSON (Project settings > Service accounts > Generate new private key).
# Leave blank only if AUTH_DEV_BYPASS=true.
FIREBASE_SERVICE_ACCOUNT_PATH=

# DEV ONLY: when true, protected routes accept a synthetic dev user instead of
# verifying a real Firebase ID token. Never set this to true in production.
AUTH_DEV_BYPASS=true

# DEV ONLY: to verify real ID tokens issued by a local Firebase Auth emulator
# instead of using AUTH_DEV_BYPASS, set AUTH_DEV_BYPASS=false, export
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 as a real shell env var (not just
# in this file - the Firebase Admin SDK reads it directly from the process
# environment), and set a project id below (any string works for the
# emulator, it doesn't need to be a real project):
# FIREBASE_PROJECT_ID=guitarflow-dev-test
FIREBASE_PROJECT_ID=
