# Base URL of the GuitarFlow FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api

# Firebase project config (Project settings > General > Your apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# DEV ONLY: set to true to run auth against a local Firebase Auth emulator
# (firebase emulators:start --only auth) instead of a real project - no
# Firebase project or the keys above are needed in that case. See README.
VITE_USE_AUTH_EMULATOR=false
